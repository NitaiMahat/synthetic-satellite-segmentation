{
  "experiment": "class_aware_barren_oversampling_rural",
  "baseline_reference": "models/baseline_v1_complete",
  "dataset": {
    "train_split": "Train/Rural",
    "validation_split": "Val/Rural",
    "image_size": [512, 512],
    "num_classes": 7
  },
  "model": {
    "architecture": "UNet",
    "base_channels": 16
  },
  "training": {
    "epochs": 15,
    "batch_size": 1,
    "learning_rate": 0.0001,
    "optimizer": "Adam",
    "seed": 42,
    "samples_per_epoch": 1366
  },
  "sampling": {
    "type": "class_aware_oversampling",
    "target_class": "Barren",
    "target_class_id": 4,
    "target_image_weight": 4.0,
    "replacement": true,
    "mask_policy": "unchanged"
  }
}
